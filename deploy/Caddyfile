# Caddy — «входная дверь» сайта на сервере (шаг 8.4): сам получает и продлевает https-сертификат Let's Encrypt для домена
# и передаёт запросы сайту (контейнер web). Домен — SITE_ADDRESS в .env (например shop.example.ua; для проверки на своём компьютере —
# localhost, тогда сертификат внутренний и браузер предупредит о нём). Запись DNS «A» домена должна указывать на сервер до первого запуска.

{$SITE_ADDRESS} {
	# сжатие страниц
	encode zstd gzip

	# загрузка XML-фида поставщика в админке (до 60 МБ, как в next.config.ts)
	request_body {
		max_size 70MB
	}

	# Caddy сам ставит X-Forwarded-For с настоящим адресом покупателя и не пропускает поддельный из запроса —
	# на нём держатся лимиты форм и входа (шаг 8.3, lib/request-ip.ts). Заголовки безопасности ставит сам сайт.
	reverse_proxy web:3000 {
		# сайт перезапускается при обновлении — подождать его, а не сразу отдавать ошибку
		lb_try_duration 30s
	}
}
