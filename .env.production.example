# Настройки сайта НА СЕРВЕРЕ (шаг 8.4). На сервере: скопировать этот файл в .env в папке проекта и вписать свои значения.
#   cp .env.production.example .env && nano .env
# Файл .env НЕЛЬЗЯ никому отправлять и загружать в git: там пароли и токены.
# Комментарии — только отдельными строками (не после значения). Пароли и ключи генерировать так (каждый раз новый):
#   openssl rand -hex 32
# Для разработки на ПК — другой шаблон: .env.example.

# ---------- адрес сайта ----------
# Домен сайта без https:// — Caddy сам получит на него сертификат. Для проверки на своём компьютере: localhost
SITE_ADDRESS=shop.example.ua
# Тот же адрес с https:// — ссылки на оплату, в сообщениях бота, вебхуки
PUBLIC_URL=https://shop.example.ua

# ---------- пароли (обязательно свои!) ----------
# Пароль базы данных: только латинские буквы и цифры (openssl rand -hex 24). Задаётся ОДИН раз до первого запуска:
# база запоминает его при создании — позже менять только вместе с паролем в самой базе.
POSTGRES_PASSWORD=change-me
# Ключ поиска (Meilisearch), от 16 символов
MEILI_MASTER_KEY=change-me-search-key
# Пароль владельца (логин owner) при первом запуске (hm seed). После входа — сменить в «Мой аккаунт» и включить код из приложения
ADMIN_TOKEN=change-me
# Ключ шифрования ключей «Интеграций». При переезде с ПК — ТОТ ЖЕ ключ, что на ПК: содержимое файла .data/secrets.key
# (или SECRETS_KEY из .env на ПК). Иначе ключи из перенесённой базы не расшифровать. Хранить вместе с копиями.
SECRETS_KEY=
# Ключ для подробного ответа /api/health?key=… (внешний сторож), от 16 символов
HEALTH_KEY=

# ---------- Telegram ----------
# Токен бота и остальные ключи ниже удобнее вписывать в админке «Интеграции» (хранятся в базе зашифрованными).
BOT_TOKEN=
ADMIN_CHAT_ID=
# Бот читает сообщения сам (долгий опрос) — на сервере это работает как есть, настраивать в Telegram ничего не нужно (шаг 8.5).
# BOT_WEBHOOK=on — не включать: вебхук у Telegram отдельно не регистрируется, бот перестал бы получать сообщения.

# На время подготовки сервера, пока магазин ещё работает на ПК (docs/LAUNCH.md): сайт на сервере не читает бота и не шлёт
# сводки, напоминания и тревоги (иначе менеджеры получали бы всё дважды). В день переезда строку удалить.
# HM_WORKER=off

# ---------- оплата, чеки, доставка, CRM, SMS (можно пусто — тогда заглушки/«Интеграции») ----------
MONO_TOKEN=
MONO_BASE=https://api.monobank.ua
CHECKBOX_LICENSE_KEY=
CHECKBOX_LOGIN=
CHECKBOX_PASSWORD=
NOVAPOSHTA_KEY=
KEYCRM_API_KEY=
KEYCRM_SOURCE_ID=
KEYCRM_WEBHOOK_SECRET=
TURBOSMS_TOKEN=
TURBOSMS_SENDER=
PREPAY_UAH=200

# ---------- аналитика и реклама (шаг А1; удобнее — «Интеграции → Аналитика и реклама», там же включатель) ----------
# GTM_ID=
# GA4_ID=
# GOOGLE_ADS_ID=
# GOOGLE_ADS_PURCHASE_LABEL=
# META_PIXEL_ID=
# TIKTOK_PIXEL_ID=

# ---------- резервные копии: вторая копия в облаке (можно вписать в «Интеграции → Резервные копии») ----------
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=

# ---------- не менять без причины ----------
# База, поиск, папки фото/копий/ключа внутри контейнера задаёт docker-compose.prod.yml:
# DATABASE_URL (из POSTGRES_PASSWORD), MEILI_HOST, MEDIA_DIR=/media, BACKUP_DIR=/backups, FEEDS_DIR=/data/feeds, SECRETS_KEY_FILE=/data/secrets.key.
# Порт сайта для проверки на самом сервере (http://127.0.0.1:3000), наружу закрыт
WEB_LOCAL_PORT=3000
