# Скопируйте этот файл в .env (без .example) и впишите свои значения.
# Файл .env НЕЛЬЗЯ никому отправлять и НЕЛЬЗЯ загружать в git: там пароли и токены.

# --- Сервер ---
NODE_ENV=development
ADMIN_TOKEN=change-me             # пароль владельца при первом входе (логин owner). ОБЯЗАТЕЛЬНО замените

# --- База данных (поднимается docker-compose, значение ниже подходит для локальной разработки как есть) ---
DATABASE_URL=postgresql://handyman:handyman@localhost:5432/handyman?schema=public

# --- Redis (фоновые задачи; docker-compose) ---
REDIS_URL=redis://localhost:6379

# --- Meilisearch (поиск; docker-compose) ---
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=change-me-search-key
# MEILI_INDEX_PRODUCTS=products     # необязательно: имя поискового индекса (тесты используют products_test)

# --- Импорт каталога ---
# FEEDS_DIR=./.data/feeds           # необязательно: куда сохраняются скачанные фиды на время проверки (хранятся последние 3, ~14 МБ каждый)

# --- S3-совместимое хранилище картинок (minio; docker-compose) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=handyman
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=handyman-uploads

# --- Ключи сервисов (шаг 3.1) ---
# Ключи ниже удобнее вписывать в админке: «Интеграции» (только владелец) — там они хранятся в базе зашифрованными.
# Значения из этого файла работают, если в «Интеграциях» поле пустое.
# SECRETS_KEY=                      # ключ шифрования (на сервере обязательно); пусто — файл .data/secrets.key создаётся сам. Храните с копией базы

# --- Telegram ---
BOT_TOKEN=                        # токен бота от @BotFather (секрет!)
ADMIN_CHAT_ID=                    # необязательно: ваш Telegram ID, чтобы бот сразу слал «Новый заказ»
PUBLIC_URL=                       # https-адрес магазина (для теста — адрес туннеля)

# --- Оплата mono (интернет-эквайринг) ---
MONO_TOKEN=                       # токен мерчанта mono (X-Token). Не личный и не корпоративный токен!
MONO_BASE=https://api.monobank.ua

# --- Новая почта ---
NOVAPOSHTA_KEY=                   # бесплатный API-ключ из кабинета Новой почты

# --- KeyCRM (без ключа работает режим-заглушка) ---
KEYCRM_API_KEY=
KEYCRM_SOURCE_ID=
KEYCRM_WEBHOOK_SECRET=change-me-too   # шаблон НЕ принимается: задайте свой (от 16 знаков) или в «Интеграциях»
KEYCRM_NP_SERVICE_ID=             # необязательно: ID службы «Нова Пошта» в KeyCRM (тогда передаётся код отделения)
KEYCRM_PUSH_ON=paid               # старый магазин; новый сайт это не читает — передача включается в «Интеграции → KeyCRM»

# --- Checkbox (кассовые чеки, шаг 3.3) ---
CHECKBOX_LICENSE_KEY=
CHECKBOX_LOGIN=
CHECKBOX_PASSWORD=
# CHECKBOX_BASE=https://api.checkbox.in.ua        # необязательно: тестовая касса — https://dev-api.checkbox.in.ua
# CHECKBOX_RECEIPT_PAGE=https://check.checkbox.ua   # необязательно: адрес страницы чека для покупателя (к нему добавляется id чека)

# --- SMS для входа (TurboSMS) ---
TURBOSMS_TOKEN=
TURBOSMS_SENDER=

# --- Стартовое значение предоплаты (потом меняется в админке) ---
PREPAY_UAH=200

# --- Фото товаров (свои копии, админка «Фото товаров») ---
MEDIA_DIR=                        # папка для фото; пусто — storage/media в папке проекта. На сервере — отдельный диск/папка

# --- Резервные копии (шаг 8.1; подробно — docs/BACKUPS.md) ---
BACKUP_DIR=                       # папка копий; пусто — .data/backups в папке проекта. На сервере — отдельный диск/том
# PG_BIN_DIR=                     # необязательно: папка с pg_dump/pg_restore (иначе — pg_dump на компьютере, затем Docker)
# PG_DOCKER_CONTAINER=handyman-next-postgres-1   # необязательно: контейнер базы, если pg_dump берётся из Docker
# HM_BACKUPS=off                  # необязательно: выключить ночные копии (только для отладки)
# Вторая копия в облаке (S3-совместимое хранилище). Удобнее вписать в админке: «Интеграции → Резервные копии».
BACKUP_S3_ENDPOINT=               # адрес хранилища, например https://<ID>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=                 # корзина (приватная)
BACKUP_S3_ACCESS_KEY=             # ключ доступа (Access Key ID)
BACKUP_S3_SECRET_KEY=             # секретный ключ (секрет!)
BACKUP_S3_REGION=                 # необязательно: для Amazon S3, например eu-central-1

# --- Журнал ошибок и «здоровье» сайта (шаг 8.2) ---
# Адрес /api/health отвечает внешнему сторожу только «ok/error». Подробности — /api/health?key=<этот ключ> (или войдя в админку).
HEALTH_KEY=                       # необязательно: длинная случайная строка (от 16 символов)
