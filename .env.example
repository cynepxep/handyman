# Скопируйте этот файл в .env (без .example) и впишите свои значения.
# Файл .env НЕЛЬЗЯ никому отправлять и НЕЛЬЗЯ загружать в git: там пароли и токены.

# --- Сервер ---
NODE_ENV=development
ADMIN_TOKEN=change-me             # пароль владельца при первом входе (логин owner). ОБЯЗАТЕЛЬНО замените

# --- База данных (поднимается docker-compose, значение ниже подходит для локальной разработки как есть) ---
DATABASE_URL=postgresql://handyman:handyman@localhost:5432/handyman?schema=public

# --- Redis (фоновые задачи; docker-compose) ---
REDIS_URL=redis://localhost:6379

# --- Meilisearch (поиск; docker-compose) ---
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=change-me-search-key
# MEILI_INDEX_PRODUCTS=products     # необязательно: имя поискового индекса (тесты используют products_test)

# --- Импорт каталога ---
# FEEDS_DIR=./.data/feeds           # необязательно: куда сохраняются скачанные фиды на время проверки (хранятся последние 3, ~14 МБ каждый)

# --- S3-совместимое хранилище картинок (minio; docker-compose) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=handyman
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=handyman-uploads

# --- Telegram ---
BOT_TOKEN=                        # токен бота от @BotFather (секрет!)
ADMIN_CHAT_ID=                    # необязательно: ваш Telegram ID, чтобы бот сразу слал «Новый заказ»
PUBLIC_URL=                       # https-адрес магазина (для теста — адрес туннеля)

# --- Оплата mono (интернет-эквайринг) ---
MONO_TOKEN=                       # токен мерчанта mono (X-Token). Не личный и не корпоративный токен!
MONO_BASE=https://api.monobank.ua

# --- Новая почта ---
NOVAPOSHTA_KEY=                   # бесплатный API-ключ из кабинета Новой почты

# --- KeyCRM (без ключа работает режим-заглушка) ---
KEYCRM_API_KEY=
KEYCRM_SOURCE_ID=
KEYCRM_WEBHOOK_SECRET=change-me-too
KEYCRM_NP_SERVICE_ID=
KEYCRM_PUSH_ON=paid

# --- Стартовое значение предоплаты (потом меняется в админке) ---
PREPAY_UAH=200

# --- Фото товаров (свои копии, админка «Фото товаров») ---
MEDIA_DIR=                        # папка для фото; пусто — storage/media в папке проекта. На сервере — отдельный диск/папка
