{
  "name": "@handyman/db",
  "private": true,
  "version": "0.0.0",
  "main": "src/client.ts",
  "types": "src/client.ts",
  "exports": {
    ".": "./src/client.ts",
    "./catalog-import": "./src/catalog-import.ts",
    "./catalog-products": "./src/catalog-products.ts",
    "./catalog-search": "./src/catalog-search.ts",
    "./site-content": "./src/site-content.ts",
    "./orders": "./src/orders.ts",
    "./clients": "./src/clients.ts",
    "./messages": "./src/messages.ts",
    "./search-stats": "./src/search-stats.ts",
    "./warehouses": "./src/warehouses.ts",
    "./novaposhta": "./src/novaposhta.ts",
    "./media": "./src/media.ts",
    "./photo-choice": "./src/photo-choice.ts",
    "./banners": "./src/banners.ts",
    "./notify": "./src/notify.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "search:reindex": "dotenv -e ../../.env -- tsx scripts/reindex.ts",
    "test": "dotenv -e ../../.env -- tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@handyman/core": "workspace:*",
    "@prisma/client": "^6.3.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "dotenv-cli": "^7.4.0",
    "prisma": "^6.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
